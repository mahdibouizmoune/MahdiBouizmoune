# Activate only after the custom domain DNS and TLS are verified.
SITE_DOMAIN_ACTIVE=false
# API key from Resend. Set in Vercel Project Settings > Environment Variables.
RESEND_API_KEY=
# Sender address on a domain verified with Resend.
CONTACT_FROM_EMAIL=
# Optional dedicated random signing secret. Defaults to RESEND_API_KEY.
CONTACT_FORM_SECRET=
# ISO date of the content update, supplied by build otherwise.
BUILD_DATE=
